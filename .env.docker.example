# Copy to .env.docker — used by the web and worker containers (service names, not 127.0.0.1)
MONGODB_URI="mongodb://mongo:27017/indiamart_scraper"
REDIS_URL="redis://redis:6379"
NODE_ENV=production

MAX_CRAWL_DEPTH=3
MAX_PAGES=1000
MAX_PRODUCTS=2000
MAX_CONCURRENCY=3
REQUEST_TIMEOUT=15000
RETRY_LIMIT=2
MAX_VERIFY_ROUNDS=3
# PROXY_URLS="http://user:pass@proxy1.example.com:8000"
