# MongoDB connection string (see docker-compose.yml for the local dev container)
MONGODB_URI="mongodb://127.0.0.1:27017/indiamart_scraper"

NODE_ENV=development

# Crawler limits — enforced starting Phase 4, safe defaults shown here
MAX_CRAWL_DEPTH=3
MAX_PAGES=50
MAX_PRODUCTS=200
MAX_CONCURRENCY=3
REQUEST_TIMEOUT=15000
RETRY_LIMIT=2

# Background jobs (Phase 7) — 127.0.0.1, not localhost (see MongoDB gotcha in handover.md, same IPv6 delay applies)
REDIS_URL="redis://127.0.0.1:6379"

# IP rotation (optional) - comma or newline separated proxies, rotated per request.
# PROXY_URLS="http://user:pass@proxy1.example.com:8000,http://user:pass@proxy2.example.com:8000"
# Extra passes over pages that failed (rate limit / crash / timeout) before the job finishes
MAX_VERIFY_ROUNDS=3
